{
  "$schema": "https://tr.designtokens.org/format/",
  "cor": {
    "fundo":      { "$type": "color", "$value": "#FFFFFF", "$extensions": { "broto.dark": "#0E1512" } },
    "superficie": { "$type": "color", "$value": "#F6F7F6", "$extensions": { "broto.dark": "#161E1A" } },
    "texto":      { "$type": "color", "$value": "#14201A", "$extensions": { "broto.dark": "#E8F1EB" } },
    "sutil":      { "$type": "color", "$value": "#5B6B62", "$extensions": { "broto.dark": "#9BAaa2" } },
    "primaria":   { "$type": "color", "$value": "#1B7F47", "$extensions": { "broto.dark": "#5FD08A" } },
    "erro":       { "$type": "color", "$value": "#B42318", "$extensions": { "broto.dark": "#F97066" } }
  },
  "tipo": {
    "display": { "$type": "fontFamily", "$value": "system" },
    "texto":   { "$type": "fontFamily", "$value": "system" },
    "escala":  { "$type": "dimension", "$value": [13, 15, 17, 22, 28] }
  },
  "espaco":   { "base": { "$type": "dimension", "$value": 8 } },
  "forma":    { "raio": { "$type": "dimension", "$value": 12 } },
  "movimento":{ "duracao": { "$type": "duration", "$value": 220 }, "curva": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] } }
}
