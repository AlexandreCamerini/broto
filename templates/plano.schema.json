{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plano Broto",
  "type": "object",
  "required": [
    "versao",
    "app",
    "pack",
    "arquitetura",
    "qualidade",
    "distribuicao",
    "ux"
  ],
  "additionalProperties": false,
  "properties": {
    "versao": {
      "const": 2
    },
    "app": {
      "type": "object",
      "required": [
        "nome",
        "uma_frase",
        "acao_principal"
      ],
      "properties": {
        "nome": {
          "type": "string",
          "minLength": 1
        },
        "uma_frase": {
          "type": "string",
          "minLength": 1
        },
        "acao_principal": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pack": {
      "enum": [
        "web",
        "ios",
        "android",
        "multi",
        "ferramenta"
      ]
    },
    "arquitetura": {
      "type": "object",
      "required": [
        "stack",
        "dados",
        "auth",
        "ia"
      ],
      "properties": {
        "stack": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "dados": {
          "type": "object",
          "required": [
            "onde",
            "guarda_dado_de_terceiro"
          ],
          "properties": {
            "onde": {
              "type": "string"
            },
            "guarda_dado_de_terceiro": {
              "type": "boolean"
            }
          }
        },
        "auth": {
          "enum": [
            "nenhuma",
            "email",
            "social",
            "magic-link"
          ]
        },
        "ia": {
          "type": "object",
          "required": [
            "usa",
            "proxy_obrigatorio"
          ],
          "properties": {
            "usa": {
              "type": "boolean"
            },
            "proxy_obrigatorio": {
              "const": true
            },
            "tarefas": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "nome",
                  "tier",
                  "streaming"
                ],
                "properties": {
                  "nome": {
                    "type": "string"
                  },
                  "tier": {
                    "enum": [
                      "haiku",
                      "sonnet",
                      "opus"
                    ]
                  },
                  "streaming": {
                    "type": "boolean"
                  },
                  "saida": {
                    "enum": [
                      "texto",
                      "json"
                    ]
                  }
                }
              }
            },
            "eval_minimo": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "teto_gasto_brl_mes": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "usa": {
                    "const": true
                  }
                }
              },
              "then": {
                "required": [
                  "tarefas",
                  "eval_minimo",
                  "teto_gasto_brl_mes"
                ]
              }
            }
          ]
        }
      }
    },
    "qualidade": {
      "type": "object",
      "required": [
        "gates"
      ],
      "properties": {
        "gates": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "required": [
              "id",
              "bloqueante",
              "limite"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "bloqueante": {
                "type": "boolean"
              },
              "limite": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "distribuicao": {
      "type": "object",
      "required": [
        "alvo",
        "passos",
        "custos_declarados"
      ],
      "properties": {
        "alvo": {
          "type": "string"
        },
        "passos": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "custos_declarados": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "item",
              "valor",
              "recorrencia"
            ],
            "properties": {
              "item": {
                "type": "string"
              },
              "valor": {
                "type": "string"
              },
              "recorrencia": {
                "enum": [
                  "unico",
                  "mensal",
                  "anual"
                ]
              }
            }
          }
        }
      }
    },
    "ux": {
      "type": "object",
      "description": "Saida do ux-director, copiada integralmente pelo arch-decider. E o contrato que o Estagio 3 implementa e que o gate ux mede.",
      "required": [
        "referencias",
        "fluxo_principal",
        "direcao_visual",
        "criterios_aceite"
      ],
      "properties": {
        "referencias": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "app",
              "url",
              "o_que_roubar"
            ],
            "properties": {
              "app": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "o_que_roubar": {
                "type": "string"
              },
              "por_que_funciona": {
                "type": "string"
              },
              "captura": {
                "type": "string",
                "description": "caminho local de screenshot da referencia, em .broto/cache/refs/"
              }
            }
          }
        },
        "fluxo_principal": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "tela",
              "objetivo",
              "acao_primaria",
              "estado_vazio",
              "estado_erro",
              "estado_carregando"
            ],
            "properties": {
              "tela": {
                "type": "string"
              },
              "objetivo": {
                "type": "string"
              },
              "acao_primaria": {
                "type": "string"
              },
              "estado_vazio": {
                "type": "string"
              },
              "estado_erro": {
                "type": "string"
              },
              "estado_carregando": {
                "type": "string"
              }
            }
          }
        },
        "direcao_visual": {
          "type": "object",
          "required": [
            "tom",
            "tipografia",
            "cores",
            "densidade",
            "movimento"
          ],
          "properties": {
            "tom": {
              "type": "string"
            },
            "tipografia": {
              "type": "object"
            },
            "cores": {
              "type": "object"
            },
            "densidade": {
              "type": "string"
            },
            "movimento": {
              "type": "string"
            }
          }
        },
        "nao_fazer": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "criterios_aceite": {
          "type": "array",
          "minItems": 5,
          "maxItems": 10,
          "description": "Verificaveis por screenshot. Sao a rubrica do gate ux.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "tela",
              "criterio"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "tela": {
                "type": "string",
                "description": "nome da tela ou '*' para todas"
              },
              "criterio": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}